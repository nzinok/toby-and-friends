<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>טובי והחברים</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Secular+One&family=Varela+Round&display=swap">
<style>
/* Layout: a toy-like 3D meadow in the header, exercise cards with rendered 3D snapshots, and a full-screen player (stage beside instructions on wide screens, stacked on phones) */
:root{
  --bg:#EAF5F3; --card:#FFFFFF; --ink:#173038; --muted:#56727A; --line:#D3E6E1;
  --sea:#178383; --sun:#F2AC28; --rose:#EE6650; --sky:#3C97E4; --grape:#8758D2; --leaf:#4CAA58;
  --sky-top:#CDEBFA; --sky-bot:#F3FBF6;
  --blob1:#BFEDE6; --blob2:#FFE3A8; --blob3:#D9CCFF; --on:#FFFFFF;
  --f-display:"Secular One","Arial Hebrew",Arial,sans-serif;
  --f-body:"Varela Round","Arial Hebrew",Arial,sans-serif;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#0C1A1F; --card:#15282E; --ink:#E6F2EF; --muted:#9DB9B4; --line:#26423F;
  --sea:#43C2BC; --sun:#F5C452; --rose:#FF8B74; --sky:#6AB6FF; --grape:#B08CFF; --leaf:#78CC80;
  --sky-top:#16324A; --sky-bot:#10262A;
  --blob1:#123B3A; --blob2:#3A2F14; --blob3:#2A2148; --on:#0C1A1F; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0C1A1F; --card:#15282E; --ink:#E6F2EF; --muted:#9DB9B4; --line:#26423F;
  --sea:#43C2BC; --sun:#F5C452; --rose:#FF8B74; --sky:#6AB6FF; --grape:#B08CFF; --leaf:#78CC80;
  --sky-top:#16324A; --sky-bot:#10262A;
  --blob1:#123B3A; --blob2:#3A2F14; --blob3:#2A2148; --on:#0C1A1F; color-scheme:dark}
*{box-sizing:border-box}
[hidden]{display:none!important}
html,body{margin:0}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:17px;line-height:1.6;direction:rtl;overflow-x:hidden}
.sky{position:fixed;inset:0;z-index:-1;overflow:hidden;pointer-events:none;animation:hue 30s linear infinite}
.sky i{position:absolute;border-radius:50%;filter:blur(40px);opacity:.85;animation:drift 18s ease-in-out infinite alternate}
.sky i:nth-child(1){width:60vmax;height:60vmax;background:var(--blob1);top:-20vmax;right:-15vmax}
.sky i:nth-child(2){width:50vmax;height:50vmax;background:var(--blob2);bottom:-20vmax;left:-15vmax;animation-delay:-6s}
.sky i:nth-child(3){width:40vmax;height:40vmax;background:var(--blob3);top:30%;left:30%;animation-delay:-12s}
@keyframes drift{to{transform:translate(8vmax,6vmax) scale(1.15)}}
@keyframes hue{50%{filter:hue-rotate(35deg)}}
.bubble{position:absolute;bottom:-40px;border-radius:50%;border:2px solid var(--sky);opacity:.3;animation:rise linear infinite}
@keyframes rise{to{transform:translateY(-115vh)}}

.wrap{max-width:1000px;margin:0 auto;padding-block:14px 56px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
h1,h2,h3{font-family:var(--f-display);font-weight:400;line-height:1.2;text-wrap:balance;margin:0}
h2{font-size:26px} h3{font-size:20px} p{margin:0}
:focus-visible{outline:3px solid var(--sun);outline-offset:3px}

.hero{background:var(--card);border-radius:30px;overflow:hidden;box-shadow:0 8px 0 var(--line);margin-bottom:18px}
.meadow{position:relative;height:300px;background:linear-gradient(180deg,var(--sky-top),var(--sky-bot));cursor:pointer}
.meadow canvas,.fallback{width:100%;height:100%;display:block}
.meadow .hint{position:absolute;bottom:10px;left:14px;font-size:13px;color:var(--muted);background:color-mix(in srgb,var(--card) 80%,transparent);padding:2px 10px;border-radius:99px}
.hero-text{display:flex;justify-content:space-between;align-items:center;gap:12px 20px;flex-wrap:wrap;padding:16px 22px 20px}
.title{font-size:clamp(32px,6vw,50px);background:linear-gradient(90deg,var(--sea),var(--sky),var(--grape),var(--rose),var(--sun),var(--sea));background-size:300% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:shine 9s linear infinite}
@keyframes shine{to{background-position:300% 0}}
.hero-text p{color:var(--muted)}
.swatches{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.swatches span{color:var(--muted);font-size:14px}
.sw{width:34px;height:34px;border-radius:50%;border:3px solid var(--card);box-shadow:0 0 0 2px var(--line);cursor:pointer;padding:0}
.sw[aria-pressed="true"]{box-shadow:0 0 0 3px var(--ink)}
.sw.rainbow{background:conic-gradient(#f0694f,#f4b12e,#4fae5a,#3e9be8,#8a5cd6,#f0694f)}
@media (max-width:600px){.meadow{height:230px}.hero-text{padding:14px 16px 18px}}

.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 20px}
.tab{font:inherit;font-family:var(--f-display);font-size:17px;padding:10px 18px;border-radius:16px;border:none;background:var(--card);color:var(--ink);cursor:pointer;box-shadow:0 4px 0 var(--line);transition:transform .15s}
.tab:active{transform:translateY(3px);box-shadow:0 1px 0 var(--line)}
.tab[aria-selected="true"]{background:var(--sea);color:var(--on);box-shadow:0 4px 0 color-mix(in srgb,var(--sea) 60%,#000)}
section{display:grid;gap:16px}
.muted{color:var(--muted)}

.path{display:flex;align-items:center;background:var(--card);border-radius:22px;padding:16px;box-shadow:0 6px 0 var(--line)}
.path .stone{flex:none;width:44px;height:44px;border-radius:50%;display:grid;place-items:center;background:var(--bg);border:3px dashed var(--line);font-size:22px;color:var(--line);transition:transform .4s}
.path .stone.on{background:radial-gradient(circle at 35% 30%,#fff7d6,var(--sun) 60%);border:none;color:#7a4b00;transform:scale(1.08)}
.path .link{flex:1;height:6px;background:var(--line);margin:0 -2px}
.path .link.on{background:var(--sun)}
.path-label{font-family:var(--f-display);font-size:20px;text-align:center}

.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:16px}
.ex{position:relative;display:grid;border-radius:24px;overflow:hidden;background:var(--card);box-shadow:0 6px 0 color-mix(in srgb,var(--c) 40%,var(--line));transition:transform .2s}
.ex:hover{transform:translateY(-4px)}
.ex:active{transform:translateY(4px)}
.thumb{aspect-ratio:4/3;max-width:100%;background:radial-gradient(circle at 50% 30%,color-mix(in srgb,var(--c) 30%,var(--sky-bot)),var(--sky-top));display:grid;place-items:center}
.thumb img{width:100%;height:100%;object-fit:cover;display:block}
.thumb .big{font-family:var(--f-display);font-size:64px;color:var(--c)}
.meta{display:flex;gap:12px;align-items:center;padding:12px 16px 16px}
.num{flex:none;width:44px;height:44px;border-radius:50%;display:grid;place-items:center;font-family:var(--f-display);font-size:22px;color:#fff;
  background:radial-gradient(circle at 32% 28%,rgba(255,255,255,.8),transparent 30%),radial-gradient(circle at 50% 60%,var(--c),color-mix(in srgb,var(--c) 55%,#000));box-shadow:inset 0 -4px 8px rgba(0,0,0,.25)}
.meta h3{font-size:20px}
.meta small{color:var(--muted);font-size:14px;display:block}
.badge{position:absolute;top:10px;left:10px;width:42px;height:42px;border-radius:50%;display:grid;place-items:center;font-size:24px;color:#7a4b00;background:radial-gradient(circle at 35% 30%,#fff7d6,var(--sun) 60%);box-shadow:0 3px 0 color-mix(in srgb,var(--sun) 50%,#000);animation:pop .5s}
@keyframes pop{from{transform:scale(0) rotate(-90deg)}}

.panel{background:var(--card);border-radius:24px;padding:20px;display:grid;gap:12px;min-width:0;box-shadow:0 6px 0 var(--line)}
.btn{font:inherit;font-family:var(--f-display);font-size:21px;padding:12px 28px;border-radius:18px;border:none;background:var(--sea);color:var(--on);cursor:pointer;box-shadow:0 5px 0 color-mix(in srgb,var(--sea) 55%,#000);transition:transform .12s}
.btn:active{transform:translateY(4px);box-shadow:0 1px 0 color-mix(in srgb,var(--sea) 55%,#000)}
.btn.alt{background:var(--card);color:var(--ink);box-shadow:0 5px 0 var(--line)}
.btn.sun{background:var(--sun);color:#3A2600;box-shadow:0 5px 0 color-mix(in srgb,var(--sun) 55%,#000)}
.btn.small{font-size:16px;padding:8px 16px}
.btn[aria-pressed="true"]{background:var(--grape);color:#fff;box-shadow:0 5px 0 color-mix(in srgb,var(--grape) 55%,#000)}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.checks{display:grid;gap:8px}
.chk{all:unset;box-sizing:border-box;cursor:pointer;display:flex;gap:12px;align-items:center;padding:10px 12px;border-radius:14px;background:var(--bg)}
.chk .box{width:32px;height:32px;flex:none;border-radius:10px;border:3px solid var(--sea);display:grid;place-items:center;color:#fff;font-weight:700;transition:transform .2s}
.chk.on .box{background:var(--leaf);border-color:var(--leaf);transform:rotate(-8deg) scale(1.1)}
.chk.on .box::after{content:"✓"}
.toilet-fig{max-width:300px;width:100%;margin:0 auto;display:block}

table.week{width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}
.week th,.week td{padding:8px 4px;text-align:center;border-bottom:2px dashed var(--line)}
.week th{font-weight:400;color:var(--muted);font-size:14px}
.star{font-size:24px;color:var(--line);display:inline-block}
.star.on{color:var(--sun);text-shadow:0 2px 0 color-mix(in srgb,var(--sun) 50%,#000)}
.tw{overflow-x:auto}
.bigstar{font-family:var(--f-display);font-size:44px;color:var(--sun);display:flex;align-items:center;gap:8px}
.bigstar b{display:inline-block;animation:spin 4s linear infinite;font-weight:400}
@keyframes spin{to{transform:rotateY(360deg)}}
.goal{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.goal input{font:inherit;padding:10px 14px;border-radius:14px;border:2px solid var(--line);background:var(--bg);color:var(--ink);min-width:0;flex:1}
.rbar{height:20px;background:var(--bg);border-radius:99px;overflow:hidden}
.rbar i{display:block;height:100%;width:0;border-radius:99px;background:linear-gradient(90deg,var(--rose),var(--sun),var(--leaf),var(--sky),var(--grape));transition:width .8s}

.parent{max-width:72ch}
.parent ul,.parent ol{margin:0;padding-inline-start:22px;display:grid;gap:6px}
.note{background:color-mix(in srgb,var(--sun) 18%,var(--card));border-radius:14px;padding:12px 14px}
.warn{border-inline-start:6px solid var(--rose);background:var(--bg);padding:12px 14px;border-radius:12px}
.src{font-size:14px;color:var(--muted)}
.src a{color:var(--sea)}

/* mission manual marking */
.ex-open{all:unset;box-sizing:border-box;cursor:pointer;display:grid}
.mark{position:absolute;top:10px;left:10px;z-index:2;min-width:48px;height:48px;border-radius:99px;border:3px dashed var(--c);background:var(--card);color:var(--ink);font-family:var(--f-display);font-size:15px;padding:0 12px;cursor:pointer;box-shadow:0 3px 0 var(--line)}
.mark[aria-pressed="true"]{border:none;font-size:26px;color:#7a4b00;background:radial-gradient(circle at 35% 30%,#fff7d6,var(--sun) 60%);box-shadow:0 3px 0 color-mix(in srgb,var(--sun) 50%,#000);animation:pop .5s}

/* journal: themed skins (each skin is a deliberate fixed look, same in light and dark) */
.log{--t-bg:linear-gradient(180deg,#bfe9ff,#ecfaff);--t-card:#fff;--t-ink:#0f3550;--t-mut:#4f7088;--t-acc:#1b8fd6;--t-acc2:#17a99b;--t-soft:#dcf2ff;--t-line:#a9d6f0;
  --t-pat:radial-gradient(circle at 20% 30%,transparent 0 8px,rgba(255,255,255,.95) 9px 11px,transparent 12px),radial-gradient(circle at 72% 70%,transparent 0 4px,rgba(255,255,255,.9) 5px 6px,transparent 7px);--t-size:150px 150px;
  position:relative;overflow:hidden;border-radius:28px;padding:20px;display:grid;gap:16px;color:var(--t-ink);background:var(--t-bg);box-shadow:0 8px 0 var(--t-line)}
.log::before{content:"";position:absolute;inset:0;pointer-events:none;background-image:var(--t-pat);background-size:var(--t-size);animation:patmove 40s linear infinite}
@keyframes patmove{to{background-position:150px -600px}}
.log>*{position:relative;min-width:0}
.log[data-skin="space"]{--t-bg:linear-gradient(160deg,#151c4d,#2d1f62);--t-card:#232d73;--t-ink:#f3f5ff;--t-mut:#b9c0f0;--t-acc:#ffd447;--t-acc2:#a68bff;--t-soft:#303b8c;--t-line:#0b1033;
  --t-pat:radial-gradient(circle at 10% 20%,#fff 0 1.5px,transparent 2.5px),radial-gradient(circle at 60% 70%,#fff 0 1px,transparent 2px),radial-gradient(circle at 85% 30%,#ffe9a0 0 2px,transparent 3px),radial-gradient(circle at 35% 85%,#c9b8ff 0 1.5px,transparent 2.5px);--t-size:140px 140px}
.log[data-skin="forest"]{--t-bg:linear-gradient(180deg,#d6efc4,#f6fbec);--t-card:#fffef7;--t-ink:#22401c;--t-mut:#5b7650;--t-acc:#3f8a2c;--t-acc2:#e08a1c;--t-soft:#e7f5da;--t-line:#b9dca2;
  --t-pat:radial-gradient(ellipse 11px 5px at 20% 30%,rgba(76,154,42,.35) 98%,transparent 100%),radial-gradient(ellipse 5px 11px at 70% 62%,rgba(242,159,48,.32) 98%,transparent 100%);--t-size:160px 160px}
.log[data-skin="rainbow"]{--t-bg:linear-gradient(135deg,#ffeaf4,#efe9ff 50%,#e2f6ff);--t-card:#fff;--t-ink:#3a2350;--t-mut:#7a6890;--t-acc:#e0407f;--t-acc2:#6a4ff0;--t-soft:#ffe6f1;--t-line:#efc4dc;
  --t-pat:radial-gradient(circle at 15% 25%,#ffd44799 0 4px,transparent 5px),radial-gradient(circle at 55% 65%,#6fd3ff99 0 3px,transparent 4px),radial-gradient(circle at 82% 20%,#ff8fc499 0 3px,transparent 4px);--t-size:130px 130px}
.log .muted{color:var(--t-mut)}
.log .note{color:#3a2600}
.log h2{color:var(--t-ink)}
.skinrow{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.skin{font:inherit;font-family:var(--f-display);font-size:16px;border:3px solid transparent;border-radius:14px;padding:6px 14px;cursor:pointer;color:#fff;box-shadow:0 3px 0 rgba(0,0,0,.2);transition:transform .2s}
.skin[aria-pressed="true"]{border-color:var(--t-ink);transform:scale(1.08)}
.skin.ocean{background:linear-gradient(135deg,#1b8fd6,#17a99b)} .skin.space{background:linear-gradient(135deg,#151c4d,#7a5cff)} .skin.forest{background:linear-gradient(135deg,#3f8a2c,#e08a1c)} .skin.rainbow{background:linear-gradient(135deg,#e0407f,#f2a33a,#6a4ff0)}
.dayhead{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:10px;background:var(--t-card);border-radius:22px;padding:12px;box-shadow:0 5px 0 var(--t-line)}
.nav{font:inherit;font-size:28px;line-height:1;width:52px;height:52px;border-radius:50%;border:none;background:var(--t-soft);color:var(--t-ink);cursor:pointer}
.hdate{text-align:center}
.hdate h2{font-size:clamp(24px,5.5vw,34px);color:var(--t-acc)}
.hdate small{color:var(--t-mut);display:block;font-size:15px}
.dtools{display:flex;gap:8px;flex-wrap:wrap;align-items:center;justify-content:center;font-size:15px}
.dtools input{font:inherit;padding:6px 10px;border-radius:12px;border:2px solid var(--t-line);background:var(--t-card);color:var(--t-ink);min-width:0}
.mini{font:inherit;font-size:15px;padding:6px 14px;border-radius:12px;border:none;background:var(--t-soft);color:var(--t-ink);cursor:pointer}
.daybar{display:flex;align-items:center;gap:12px;flex-wrap:wrap;justify-content:space-between}
.daystars{font-family:var(--f-display);font-size:24px;color:var(--t-ink);display:flex;align-items:center;gap:6px;background:var(--t-card);padding:4px 16px;border-radius:99px;box-shadow:0 4px 0 var(--t-line)}
.daystars b{display:inline-block;font-weight:400;color:#f5b82e;font-size:30px}
.daystars.bump b{animation:starbump .6s}
@keyframes starbump{40%{transform:scale(1.7) rotate(25deg)}}
.slots{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px}
.slot{background:var(--t-card);border-radius:22px;padding:14px;display:grid;gap:10px;align-content:start;box-shadow:0 5px 0 var(--t-line);border:3px solid transparent;transition:border-color .3s}
.slot.s-yes,.slot.s-no{border-color:var(--t-acc2)}
.slot.just{animation:slotpop .7s}
@keyframes slotpop{0%{transform:perspective(600px) rotateY(-35deg) scale(.92)}55%{transform:perspective(600px) rotateY(10deg) scale(1.05)}100%{transform:none}}
.slot-top{display:flex;gap:10px;align-items:center}
.slot-top svg{flex:none;width:46px;height:46px}
.slot-top div{flex:1;min-width:0}
.slot-top b{font-family:var(--f-display);font-weight:400;font-size:18px;display:block;line-height:1.25}
.slot-top small{color:var(--t-mut);font-size:14px}
.sstar{font-size:30px;color:var(--t-soft)}
.s-yes .sstar,.s-no .sstar{color:#f5b82e;animation:starbump .6s}
.sbtns{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.sb{font:inherit;font-family:var(--f-display);font-size:16px;line-height:1.25;padding:10px 8px;border-radius:14px;border:none;cursor:pointer;color:#fff;background:var(--t-acc);box-shadow:0 4px 0 rgba(0,0,0,.22)}
.log[data-skin="space"] .sb{color:#151c4d}
.sb.no{background:var(--t-acc2);color:#fff}
.sb.skip{grid-column:1/-1;background:transparent;color:var(--t-mut);box-shadow:none;font-family:var(--f-body);font-size:14px;padding:2px;text-decoration:underline}
.sb:active{transform:translateY(3px);box-shadow:0 1px 0 rgba(0,0,0,.2)}
.sbtns.has .sb[aria-pressed="false"]{opacity:.4}
.sb[aria-pressed="true"]{outline:3px solid var(--t-ink);outline-offset:2px}
.result{display:flex;align-items:center;gap:10px}
.result svg{width:64px;height:64px;flex:none}
.result p{flex:1;font-family:var(--f-display);font-size:18px;line-height:1.3}
.result small{display:block;font-family:var(--f-body);color:var(--t-mut);font-size:13px}
.result .acts{display:grid;gap:6px}
.chg{font:inherit;font-size:13px;border:none;background:var(--t-soft);color:var(--t-ink);border-radius:10px;padding:4px 10px;cursor:pointer}
.extra{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:12px}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chipb{font:inherit;font-size:14px;padding:6px 12px;border-radius:99px;border:2px solid var(--t-line);background:var(--t-card);color:var(--t-ink);cursor:pointer}
.chipb[aria-pressed="true"]{background:var(--t-acc2);border-color:var(--t-acc2);color:#fff}
.chipb[aria-pressed="true"]::before{content:"✓ "}
.endday{justify-self:center;font-size:24px;padding:14px 34px}
.week-wrap{background:var(--t-card);border-radius:22px;padding:14px;display:grid;gap:10px;box-shadow:0 5px 0 var(--t-line)}
.wtab{width:100%;border-collapse:separate;border-spacing:3px;min-width:500px;font-size:13px}
.wtab th{font-weight:400;color:var(--t-mut);text-align:start;white-space:nowrap}
.wtab thead th button{all:unset;box-sizing:border-box;cursor:pointer;display:grid;justify-items:center;padding:4px 2px;border-radius:12px;width:100%;font-family:var(--f-display);color:var(--t-ink);font-size:14px}
.wtab thead th button small{font-family:var(--f-body);color:var(--t-mut);font-size:12px}
.wtab thead th.sel button{background:var(--t-acc);color:#fff}
.log[data-skin="space"] .wtab thead th.sel button{color:#151c4d}
.wtab thead th.sel button small{color:inherit}
.wtab td{background:var(--t-soft);border-radius:10px;height:40px;text-align:center;vertical-align:middle;color:var(--t-ink)}
.wtab td svg{width:32px;height:32px;vertical-align:middle}
.wtab td.sel{box-shadow:inset 0 0 0 2px var(--t-acc)}
.ck{color:var(--t-acc2);font-size:20px;font-weight:700}
.dash,.sat{color:var(--t-mut);font-size:12px}
.texlegend{display:flex;flex-wrap:wrap;gap:6px 14px;margin:8px 0}
.texlegend span{display:flex;align-items:center;gap:4px}
.texlegend svg{width:32px;height:32px}

/* texture chooser */
.sheet{position:fixed;inset:0;z-index:22;background:rgba(10,20,30,.45);display:flex;align-items:flex-end;justify-content:center}
.sheet-card{width:min(680px,100%);background:var(--card);color:var(--ink);border-radius:28px 28px 0 0;padding-block:18px calc(18px + env(safe-area-inset-bottom,0px));padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));display:grid;gap:12px;animation:sheetup .35s ease-out;max-height:90vh;overflow-y:auto}
@keyframes sheetup{from{transform:translateY(100%)}}
.tex{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:10px}
