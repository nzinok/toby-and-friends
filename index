<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
(function(){const s=document.querySelector('.sky');for(let i=0;i<12;i++){const b=document.createElement('span');b.className='bubble';const z=10+Math.random()*30;b.style.cssText=`width:${z}px;height:${z}px;left:${Math.random()*100}%;animation-duration:${12+Math.random()*14}s;animation-delay:${-Math.random()*20}s`;s.appendChild(b);}})();

const COLORS={green:[0x3f9a4a,0x7cc96e],blue:[0x2f7fd6,0x86c6ff],purple:[0x7b4fd0,0xbfa2ff],orange:[0xe0731f,0xffc06a],rainbow:null};
let turtleColor='rainbow';
const HAS3D=(()=>{if(!window.THREE)return false;try{const c=document.createElement('canvas');return !!(c.getContext('webgl')||c.getContext('experimental-webgl'));}catch(e){return false;}})();

/* ================= 3D world ================= */
function build3D(){
  const V=THREE.Vector3, UP=new V(0,1,0);
  const M=(c,r=.6,x={})=>new THREE.MeshStandardMaterial(Object.assign({color:c,roughness:r,metalness:0},x));
  const Sp=(r,m,w=28,h=20)=>new THREE.Mesh(new THREE.SphereGeometry(r,w,h),m);
  const MW=M(0xffffff,.2), MB=M(0x1a2228,.3), PINK=M(0xff9fb3,.6);
  const blank=()=>({breath:0,blow:0,squeeze:0,lift:0,arch:0,walk:0,sleep:0,wave:0});
  function eyes(par,x,y,z,r){const arr=[];[-1,1].forEach(s=>{const g=new THREE.Group();g.position.set(s*x,y,z);par.add(g);g.add(Sp(r,MW,20,16));const p=Sp(r*.6,MB,16,12);p.position.z=r*.55;g.add(p);const h=Sp(r*.22,MW,8,8);h.position.set(r*.25,r*.3,r*.95);g.add(h);arr.push(g);});return arr;}
  function cheeks(par,x,y,z,r){[-1,1].forEach(s=>{const c=Sp(r,PINK,12,10);c.position.set(s*x,y,z);c.scale.set(1,.6,.45);par.add(c);});}
  function blinkAll(arr,t,closed,off=0){const b=((t+off)%4.1)<.13;arr.forEach(e=>e.scale.y=closed?.08:(b?.1:1));}
  function cyl(r,m){const mesh=new THREE.Mesh(new THREE.CylinderGeometry(r,r,1,16),m);mesh.setTo=(a,b)=>{const d=new V().subVectors(b,a);const L=d.length();mesh.position.copy(a).addScaledVector(d,.5);mesh.scale.set(1,L,1);mesh.quaternion.setFromUnitVectors(UP,d.normalize());};return mesh;}
  function tube(mesh,pts,r){mesh.geometry.dispose();mesh.geometry=new THREE.TubeGeometry(new THREE.CatmullRomCurve3(pts),40,r,18,false);}

  function platform(r){
    const g=new THREE.Group();
    const top=new THREE.Mesh(new THREE.CylinderGeometry(r,r*1.03,.35,72),M(0x86c777,.95));top.position.y=-.175;top.receiveShadow=true;g.add(top);
    const side=new THREE.Mesh(new THREE.CylinderGeometry(r*1.03,r*.9,.55,72),M(0xc99c6c,.95));side.position.y=-.62;g.add(side);
    const cols=[0xff7aa2,0xffd04d,0x8fc7ff,0xffffff,0xc79cff];
    for(let i=0;i<16;i++){const a=i/16*Math.PI*2+.13*Math.sin(i*7),rr=r*(.8+.12*Math.sin(i*3.3));const f=new THREE.Group();f.position.set(Math.cos(a)*rr,0,Math.sin(a)*rr);
      const st=new THREE.Mesh(new THREE.CylinderGeometry(.025,.025,.26,6),M(0x4f9a4f));st.position.y=.13;f.add(st);
      for(let k=0;k<5;k++){const p=Sp(.06,M(cols[i%5],.5),10,8);p.position.set(Math.cos(k*1.256)*.07,.28,Math.sin(k*1.256)*.07);f.add(p);}
      const c=Sp(.05,M(0xffe066,.5),10,8);c.position.y=.3;f.add(c);f.traverse(m=>{if(m.isMesh)m.castShadow=true;});g.add(f);}
    for(let i=0;i<22;i++){const a=i*2.4,rr=r*(.25+.6*((i*37)%11)/11);const c=new THREE.Mesh(new THREE.ConeGeometry(.06,.22,5),M(0x6fbf5f,.9));c.position.set(Math.cos(a)*rr,.1,Math.sin(a)*rr);g.add(c);}
    return g;
  }

  /* --- Toby the turtle --- */
  function toby(){
    const shellM=M(0x3f9a4a,.4),plateM=M(0x7cc96e,.45),rimM=M(0xe7c56e,.55),skinM=M(0x9fd98f,.6),bellyM=M(0xf6e7ad,.7);
    const root=new THREE.Group(),body=new THREE.Group();root.add(body);
    const shellG=new THREE.Group();body.add(shellG);
    const dome=new THREE.Mesh(new THREE.SphereGeometry(1.3,48,32,0,Math.PI*2,0,Math.PI/2),shellM);dome.scale.set(1,.8,1.15);shellG.add(dome);
    const rim=new THREE.Mesh(new THREE.TorusGeometry(1.3,.14,16,64),rimM);rim.rotation.x=Math.PI/2;rim.scale.set(1,1.15,1);shellG.add(rim);
    const pg=new THREE.SphereGeometry(.34,24,14);
    const plate=(th,ph,s)=>{const p=new V(Math.sin(th)*Math.cos(ph)*1.3,Math.cos(th)*1.3*.8,Math.sin(th)*Math.sin(ph)*1.3*1.15);const m=new THREE.Mesh(pg,plateM);m.position.copy(p);m.scale.set(s,s,.3*s);m.lookAt(p.clone().multiplyScalar(2));shellG.add(m);};
    plate(.01,.3,1.2);for(let i=0;i<6;i++)plate(.95,i*Math.PI/3+.52,.95);
    const belly=Sp(1.28,bellyM,32,16);belly.scale.set(1,.22,1.15);body.add(belly);
    const headG=new THREE.Group();headG.position.set(0,.3,1.45);body.add(headG);
    const neck=new THREE.Mesh(new THREE.CylinderGeometry(.27,.32,.7,20),skinM);neck.rotation.x=Math.PI/2;neck.position.set(0,0,-.2);headG.add(neck);
    const head=Sp(.55,skinM,32,24);head.position.set(0,.15,.3);head.scale.set(1,.92,1.05);headG.add(head);
    const ey=eyes(headG,.23,.33,.72,.16);cheeks(headG,.38,.08,.64,.09);
    const smile=new THREE.Mesh(new THREE.TorusGeometry(.15,.028,8,24,Math.PI),MB);smile.rotation.z=Math.PI;smile.position.set(0,.08,.83);headG.add(smile);
    const legs=[];[[1,1],[-1,1],[1,-1],[-1,-1]].forEach(([x,z])=>{const l=Sp(.38,skinM,20,14);l.position.set(x*1.05,-.1,z*.78);l.scale.set(.9,.55,1.2);body.add(l);legs.push(l);});
    const tail=new THREE.Mesh(new THREE.ConeGeometry(.15,.45,12),skinM);tail.rotation.x=-Math.PI/2;tail.position.set(0,-.02,-1.6);body.add(tail);
    const bubM=M(0x8fd3ff,.1,{transparent:true,opacity:.75});
    const bubs=[];for(let i=0;i<14;i++){const b=Sp(.09,bubM,12,10);b.visible=false;root.add(b);bubs.push({m:b,life:0,v:new V()});}
    let bubT=0;
    function update(t,dt,s){
      const sh=1+.17*s.breath-.07*s.blow;
      shellG.scale.set(sh,sh*(1+.14*s.arch),sh);shellG.position.y=.1*s.arch;belly.scale.set(sh,.22,1.15*sh);
      headG.position.z=1.45-.8*s.squeeze-.2*s.sleep;headG.scale.setScalar(1-.28*s.squeeze);headG.rotation.x=.35*s.sleep+Math.sin(t*1.3)*.04;
      const lg=1-.55*s.squeeze;legs.forEach((l,i)=>{l.scale.set(.9*lg,.55*lg,1.2*lg);l.rotation.y=Math.sin(t*7+i*1.6)*.5*s.walk;});
      tail.rotation.y=Math.sin(t*3)*.4;
      body.position.y=.4+.6*s.lift+Math.sin(t*2)*.03+Math.abs(Math.sin(t*6))*.14*s.walk;
      body.rotation.z=Math.sin(t*6)*.13*s.walk;body.rotation.x=-.2*s.lift;
      blinkAll(ey,t,s.sleep>.5);
      if(turtleColor==='rainbow'){const hu=(t*.04)%1;shellM.color.setHSL(hu,.6,.42);plateM.color.setHSL((hu+.08)%1,.65,.62);}
      else{const c=COLORS[turtleColor];shellM.color.setHex(c[0]);plateM.color.setHex(c[1]);}
      if(s.blow>.5){bubT-=dt;if(bubT<=0){bubT=.14;const b=bubs.find(b=>b.life<=0);if(b){b.life=1.3;b.m.visible=true;const p=new V(0,.1,.95);headG.localToWorld(p);root.worldToLocal(p);b.m.position.copy(p);b.v.set((Math.random()-.5)*.5,.4+Math.random()*.5,1.3);b.m.scale.setScalar(.6+Math.random()*1.1);}}}
      bubs.forEach(b=>{if(b.life>0){b.life-=dt;b.m.position.addScaledVector(b.v,dt);if(b.life<=0)b.m.visible=false;}});
    }
    return {root,update};
  }

  /* --- the little tap --- */
  function tap(){
    const g=new THREE.Group();const metal=M(0xa9bccb,.25,{metalness:.55});const red=M(0xf0694f,.4);
    const post=new THREE.Mesh(new THREE.CylinderGeometry(.13,.16,1.8,24),metal);post.position.y=.9;g.add(post);
    const arm=new THREE.Mesh(new THREE.CylinderGeometry(.11,.11,.85,20),metal);arm.rotation.z=Math.PI/2;arm.position.set(-.42,1.72,0);g.add(arm);
    const spout=new THREE.Mesh(new THREE.CylinderGeometry(.12,.09,.32,20),metal);spout.position.set(-.82,1.58,0);g.add(spout);
    const handle=new THREE.Group();handle.position.set(0,1.85,0);g.add(handle);
    const hb=new THREE.Mesh(new THREE.CylinderGeometry(.06,.06,.25,12),metal);hb.position.y=.1;handle.add(hb);
    const bar=new THREE.Mesh(new THREE.BoxGeometry(.7,.09,.14),red);bar.position.y=.25;handle.add(bar);
    const bar2=bar.clone();bar2.rotation.y=Math.PI/2;handle.add(bar2);
    [[.35,0],[-.35,0],[0,.35],[0,-.35]].forEach(([x,z])=>{const k=Sp(.08,red,12,10);k.position.set(x,.25,z);handle.add(k);});
    const water=new THREE.Mesh(new THREE.CylinderGeometry(.065,.1,1,16),M(0x5fbfff,.1,{transparent:true,opacity:.7}));water.position.set(-.82,.95,0);g.add(water);
    const basin=new THREE.Mesh(new THREE.SphereGeometry(.5,28,14,0,Math.PI*2,Math.PI/2,Math.PI/2),M(0xe9f2f7,.35,{side:THREE.DoubleSide}));basin.position.set(-.82,.5,0);g.add(basin);
    const pool=new THREE.Mesh(new THREE.CircleGeometry(.42,28),M(0x6fc6ff,.1,{transparent:true,opacity:.8}));pool.rotation.x=-Math.PI/2;pool.position.set(-.82,.32,0);g.add(pool);
    const drops=[];for(let i=0;i<6;i++){const d=Sp(.05,M(0x6fc6ff,.1),8,8);d.position.set(-.82,1.4-i*.18,0);g.add(d);drops.push(d);}
    let level=.3;
    function update(t,dt,s){const open=1-s.squeeze;handle.rotation.y=-open*Math.PI*.75;water.scale.y=Math.max(.001,open);water.position.y=1.45-.5*open;water.visible=open>.03;
      level=Math.min(.95,Math.max(.1,level+(open>.5?dt*.04:-dt*.01)));pool.position.y=.08+.32*level;pool.scale.setScalar(.6+.4*level);
      drops.forEach((d,i)=>{d.visible=open>.3;d.position.y=1.42-((t*1.6+i/6)%1)*1.0;});}
    return {root:g,update};
  }

  /* --- balloon --- */
  function balloon(){
    const g=new THREE.Group();const red=M(0xff5a6e,.22);
    const bg=new THREE.Group();g.add(bg);const b=Sp(.5,red,32,24);b.scale.set(1,1.15,1);bg.add(b);
    const knot=new THREE.Mesh(new THREE.ConeGeometry(.08,.14,12),red);knot.position.y=-.62;knot.rotation.x=Math.PI;bg.add(knot);
    const sh=Sp(.08,M(0xffffff,.1),10,8);sh.position.set(.2,.3,.4);bg.add(sh);
    const str=cyl(.012,M(0x777777));g.add(str);
    let v=0;
    function update(t,dt,s){v=Math.min(1,Math.max(0,v+(s.blow>.4?dt*.07:-dt*.02)));const k=.35+.8*v;bg.scale.setScalar(k);bg.position.y=.9+.6*k+Math.sin(t*1.5)*.05;bg.rotation.z=Math.sin(t*1.2)*.08;
      str.setTo(new V(0,0,0),new V(Math.sin(t*1.2)*-.05,bg.position.y-.68*k,0));}
    return {root:g,update};
  }

  /* --- Dubi the bear --- */
  function bear(pose){
    const fur=M(0xb5814f,.75),light=M(0xf3d6ab,.8),dark=M(0x3b2a20,.4);
    const root=new THREE.Group();
    const head=new THREE.Group();root.add(head);
    head.add(Sp(.62,fur,32,24));
    [-1,1].forEach(s=>{const e=Sp(.24,fur,16,12);e.position.set(s*.45,.45,-.05);head.add(e);const ei=Sp(.13,PINK,12,10);ei.position.set(s*.45,.45,.1);ei.scale.z=.5;head.add(ei);});
    const snout=Sp(.28,light);snout.position.set(0,-.15,.5);snout.scale.set(1.1,.8,.8);head.add(snout);
    const nose=Sp(.1,dark,12,10);nose.position.set(0,-.05,.74);nose.scale.set(1.3,.9,.8);head.add(nose);
    const ey=eyes(head,.23,.13,.52,.1);cheeks(head,.38,-.08,.47,.09);
    let update;
    if(pose==='lie'){
      const bodyM=Sp(1,fur,36,24);bodyM.scale.set(1.25,.65,.85);bodyM.position.y=.6;root.add(bodyM);
      const belly=Sp(.75,light);belly.scale.set(1.05,.4,.7);belly.position.set(.05,1.0,0);root.add(belly);
      head.position.set(-1.45,.75,0);head.rotation.set(-.8,0,0);
