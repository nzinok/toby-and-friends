 moon:`<path d="M29 7a16 16 0 1 0 12 27A13 13 0 0 1 29 7z" fill="${B}"/><path d="M37 9l1.5 3.5 3.5 1.5-3.5 1.5-1.5 3.5-1.5-3.5-3.5-1.5 3.5-1.5z" fill="${A}"/>`}[k];
 return `<svg viewBox="0 0 48 48" aria-hidden="true">${b}</svg>`;}

/* effects */
const calm=()=>matchMedia('(prefers-reduced-motion: reduce)').matches;
function burst(x,y,n=16,kind){if(calm())return;kind=kind||SKINS[curSkin].pt;const cols=['#ff4f98','#ffb84d','#6f55ff','#36c5f0','#5fd068'];
  for(let i=0;i<n;i++){const p=document.createElement('span');p.className='pt '+kind;if(kind==='dot')p.style.background=cols[i%5];document.body.appendChild(p);
    const a=Math.random()*Math.PI*2,r=60+Math.random()*90,dx=Math.cos(a)*r,dy=Math.sin(a)*r-40;
    p.animate([{transform:`translate(${x}px,${y}px) scale(.4) rotate(0)`,opacity:1},{transform:`translate(${x+dx}px,${y+dy}px) scale(1.2) rotate(${Math.random()*540}deg)`,opacity:0}],{duration:900+Math.random()*500,easing:'cubic-bezier(.2,.8,.3,1)'}).onfinish=()=>p.remove();}}
function flyStar(rect){const t=$('dayStars');if(!t||!t.offsetParent||calm()){bumpStars();return;}const tr=t.getBoundingClientRect();
  const s=document.createElement('span');s.className='flystar';s.textContent='★';document.body.appendChild(s);
  const x0=rect.left+rect.width/2-16,y0=rect.top+rect.height/2-16,x1=tr.left+18,y1=tr.top+4;
  s.animate([{transform:`translate(${x0}px,${y0}px) scale(.5)`},{transform:`translate(${(x0+x1)/2}px,${Math.min(y0,y1)-80}px) scale(1.6) rotate(180deg)`},{transform:`translate(${x1}px,${y1}px) scale(.8) rotate(360deg)`}],{duration:900,easing:'ease-in-out'}).onfinish=()=>{s.remove();bumpStars();};}
function bumpStars(){const t=$('dayStars');if(!t)return;t.classList.remove('bump');void t.offsetWidth;t.classList.add('bump');}
function toast(msg){document.querySelectorAll('.toast').forEach(t=>t.remove());const t=document.createElement('div');t.className='toast';t.textContent=msg;document.body.appendChild(t);setTimeout(()=>t.remove(),2000);}

/* manual exercise marking (mission cards + journal chips) */
function toggleEx(d,id,rect){const was=d.ex.includes(id);if(was)d.ex=d.ex.filter(x=>x!==id);else d.ex.push(id);save();renderMission();renderLog();
  if(was)return;burst(rect.left+rect.width/2,rect.top+rect.height/2,14);beep(880,.2);
  if(d.ex.length>=6){toast('המשימה היומית הושלמה!');confetti();flyStar(rect);}else toast(pick(CHEERS));}

/* journal view */
function renderLog(){
  const L=$('logBox');L.dataset.skin=curSkin;
  const k=dkey(sel),d=getD(k),isToday=k===dkey(new Date());
  $('hName').textContent=DAYN[sel.getDay()]+(isToday?' · היום':'');
  $('hDate').textContent=hebDate(sel);
  $('gDate').textContent=sel.toLocaleDateString('he-IL');
  $('logDate').value=k;
  $('dayStarN').textContent=starsOf(d);
  const box=$('slots');box.innerHTML='';
  SLOTS.forEach((s,i)=>{const e=d.log[i],st=e?e.s:'none';const c=document.createElement('div');c.className='slot s-'+st;c.dataset.i=i;
    const sub={none:'עוד לא סומן',yes:'הצליח!',no:'ישבתי',skip:'דילגנו'}[st];let body;
    if(st==='none')body=`<div class="sbtns"><button class="sb yes" data-a="yes">הצליח!</button><button class="sb no" data-a="no">ישבתי, לא הפעם</button><button class="sb skip" data-a="skip">דילגנו הפעם</button></div>`;
    else if(st==='yes')body=e.t?`<div class="result">${texIcon(e.t)}<p>${TEX[e.t].n}<small>${TEX[e.t].d}</small></p><div class="acts"><button class="chg" data-a="tex">החלפה</button><button class="chg" data-a="reset">ביטול</button></div></div>`
      :`<div class="result"><p>איך זה נראה?</p><div class="acts"><button class="sb" data-a="tex">בחירה</button><button class="chg" data-a="reset">ביטול</button></div></div>`;
    else if(st==='no')body=`<div class="result"><p>גם ישיבה היא הצלחה!<small>קיבלת כוכב על המאמץ</small></p><button class="chg" data-a="reset">ביטול</button></div>`;
    else body=`<div class="result"><p>דילגנו הפעם<small>אפשר לסמן מחדש</small></p><button class="chg" data-a="reset">ביטול</button></div>`;
    c.innerHTML=`<div class="slot-top">${slotIcon(s.ic)}<div><b>${s.n}</b><small>${sub}</small></div><span class="sstar">★</span></div>${body}`;
    box.appendChild(c);});
  $('cleanYes').setAttribute('aria-pressed',d.clean===true);$('cleanNo').setAttribute('aria-pressed',d.clean===false);
  $('cleanBtns').classList.toggle('has',d.clean!==null);
  $('cleanSub').textContent=d.clean===true?'סומן: נקי':d.clean===false?'סומן: לא היום':'רק סימון, בלי כוכבים';
  const ch=$('exChips');ch.innerHTML='';
  EX.forEach(e=>{const b=document.createElement('button');b.className='chipb';b.textContent=e.name;b.setAttribute('aria-pressed',d.ex.includes(e.id));
    b.onclick=()=>toggleEx(getD(dkey(sel)),e.id,b.getBoundingClientRect());ch.appendChild(b);});
  renderWeek();
}
$('slots').onclick=ev=>{const b=ev.target.closest('[data-a]');if(!b)return;const card=b.closest('.slot'),i=+card.dataset.i,a=b.dataset.a;
  if(a==='tex'){openTex(i);return;}
  const d=getD(dkey(sel)),before=starsOf(d),rect=card.getBoundingClientRect();
  d.log[i]=a==='reset'?null:{s:a,t:null};save();renderLog();
  const nc=document.querySelector(`.slot[data-i="${i}"]`);
  if(a==='yes'||a==='no'){nc.classList.add('just');burst(rect.left+rect.width/2,rect.top+rect.height/3,18);beep(880,.2);if(starsOf(d)>before)flyStar(rect);toast(a==='no'?'גם ישיבה היא הצלחה!':pick(CHEERS));}
  if(a==='yes')setTimeout(()=>openTex(i),500);else checkDone();};
function openTex(i){const g=$('texGrid');g.innerHTML='';
  for(let n=1;n<=7;n++){const b=document.createElement('button');b.className='tx';b.innerHTML=`${texIcon(n)}<b>${TEX[n].n}</b><small>${TEX[n].d}</small>`;
    b.onclick=()=>{const d=getD(dkey(sel));d.log[i]={s:'yes',t:n};save();$('texSheet').hidden=true;renderLog();
      const nc=document.querySelector(`.slot[data-i="${i}"]`);nc.classList.add('just');const r=nc.getBoundingClientRect();burst(r.left+r.width/2,r.top+r.height/2,12);toast(TEX[n].n+'! נרשם');checkDone();};
    g.appendChild(b);}
  $('texSheet').hidden=false;}
$('texClose').onclick=()=>{$('texSheet').hidden=true;checkDone();};
$('texSheet').onclick=e=>{if(e.target.id==='texSheet'){$('texSheet').hidden=true;checkDone();}};
function setClean(v){const d=getD(dkey(sel));d.clean=d.clean===v?null:v;save();renderLog();$('cleanCard').classList.add('just');beep(700,.15);checkDone();}
$('cleanYes').onclick=()=>setClean(true);$('cleanNo').onclick=()=>setClean(false);
function checkDone(){const d=getD(dkey(sel));if(!d.cel&&d.log.every(x=>x)&&d.clean!==null&&$('texSheet').hidden)setTimeout(celebrate,450);}
function celebrate(){const d=getD(dkey(sel));d.cel=true;save();
  const sat=d.log.filter(x=>x&&(x.s==='yes'||x.s==='no')).length,ok=d.log.filter(x=>x&&x.s==='yes').length,n=starsOf(d);
  $('celeT').textContent=(S.name?S.name+', ':'')+pick(PRAISE);
  const lines=[];if(sat)lines.push(`ישבת ${sat} פעמים`);if(ok)lines.push(`הצלחת ${ok} פעמים`);if(d.ex.length>=6)lines.push('סיימת את המשימה היומית');
  $('celeX').textContent=lines.length?lines.join(' · '):'כל יום הוא התחלה חדשה. מחר ממשיכים!';
  $('celeS').innerHTML=Array.from({length:n},(_,i)=>`<span style="animation-delay:${.3+i*.15}s">★</span>`).join('');
  $('cele').hidden=false;confetti();[660,880,990,1180].forEach((f,i)=>setTimeout(()=>beep(f,.25),i*150));
  setTimeout(()=>{burst(innerWidth*.25,innerHeight*.35,20);burst(innerWidth*.75,innerHeight*.35,20);},300);}
$('celeOk').onclick=()=>{$('cele').hidden=true;};
$('endDay').onclick=celebrate;

/* week grid */
function cellHTML(e){if(!e)return'';if(e.s==='yes')return e.t?texIcon(e.t):'<span class="ck">✓</span>';if(e.s==='no')return'<span class="sat">ישב</span>';return'<span class="dash">–</span>';}
function weekDays(){const ws=weekStart(sel);return Array.from({length:7},(_,i)=>addDays(ws,i));}
function renderWeek(){const days=weekDays(),sk=dkey(sel),cls=x=>dkey(x)===sk?' class="sel"':'';
  $('wRange').textContent=hebDate(days[0],false)+' – '+hebDate(days[6]);
  let h='<thead><tr><th></th>'+days.map((x,i)=>`<th${cls(x)}><button data-k="${dkey(x)}">${DAYS[i]}<small>${hebDay(x)}</small></button></th>`).join('')+'</tr></thead><tbody>';
  SLOTS.forEach((s,si)=>{h+=`<tr><th>${s.sh}</th>`+days.map(x=>{const d=S.days[dkey(x)];return `<td${cls(x)}>${cellHTML(d&&d.log?d.log[si]:null)}</td>`;}).join('')+'</tr>';});
  h+='<tr><th>בגד נקי</th>'+days.map(x=>{const d=S.days[dkey(x)],c=d?d.clean:null;return `<td${cls(x)}>${c===true?'<span class="ck">✓</span>':c===false?'<span class="dash">לא</span>':''}</td>`;}).join('')+'</tr>';
  h+='<tr><th>משימה</th>'+days.map(x=>{const d=S.days[dkey(x)],n=d&&d.ex?d.ex.length:0;return `<td${cls(x)}>${n>=6?'<span class="ck">★</span>':n?`<span class="sat">${n}/6</span>`:''}</td>`;}).join('')+'</tr></tbody>';
  $('wtab').innerHTML=h;}
$('wtab').onclick=e=>{const b=e.target.closest('button[data-k]');if(!b)return;sel=parseKey(b.dataset.k);renderLog();$('logBox').scrollIntoView({behavior:'smooth',block:'start'});};
$('wPrev').onclick=()=>{sel=addDays(sel,-7);renderLog();};$('wNext').onclick=()=>{sel=addDays(sel,7);renderLog();};
$('dPrev').onclick=()=>{sel=addDays(sel,-1);renderLog();};$('dNext').onclick=()=>{sel=addDays(sel,1);renderLog();};
$('dToday').onclick=()=>{sel=new Date();sel.setHours(12,0,0,0);renderLog();};
$('logDate').onchange=e=>{if(e.target.value){sel=parseKey(e.target.value);renderLog();}};
const kn=$('kidName');kn.value=S.name||'';kn.oninput=()=>{S.name=kn.value.trim();save();};

/* skins */
Object.entries(SKINS).forEach(([k,v])=>{const b=document.createElement('button');b.className='skin '+k;b.textContent=v.n;b.setAttribute('aria-pressed',k===curSkin);
  b.onclick=()=>{curSkin=k;S.skin=k;save();document.querySelectorAll('.skin').forEach(x=>x.setAttribute('aria-pressed',x===b));renderLog();const r=b.getBoundingClientRect();burst(r.left+r.width/2,r.top+r.height/2,14);};
  $('skins').appendChild(b);});

/* print */
function printWeek(){const days=weekDays(),sk=SKINS[curSkin],P=$('printSheet');
  P.style.setProperty('--p-acc',sk.acc);P.style.setProperty('--p-soft',sk.soft);P.style.setProperty('--p-line',sk.line);
  let sat=0,ok=0,clean=0,mis=0;
  const rows=days.map((x,i)=>{const d=S.days[dkey(x)]||{};const log=d.log||[];
    const cells=SLOTS.map((s,si)=>{const e=log[si];if(!e)return'<td></td>';if(e.s!=='skip')sat++;
      if(e.s==='yes'){ok++;return `<td>${e.t?texIcon(e.t)+TEX[e.t].n+' ('+e.t+')':'הצליח'}</td>`;}return `<td>${e.s==='no'?'ישב':'דילוג'}</td>`;}).join('');
    if(d.clean===true)clean++;const exn=d.ex?d.ex.length:0;if(exn>=6)mis++;
    return `<tr><td class="day">${DAYN[i]}<br><b>${hebDate(x,false)}</b><br><small>${x.toLocaleDateString('he-IL')}</small></td>${cells}<td>${d.clean===true?'✓ נקי':d.clean===false?'לא':''}</td><td>${exn>=6?'★ הושלמה':exn?exn+'/6':''}</td><td>${d.log||d.ex?'★ '+starsOf(getD(dkey(x))):''}</td></tr>`;}).join('');
  P.innerHTML=`<div class="ps"><div class="ps-head"><div><h1>יומן הכס של ${S.name||'האלוף שלנו'}</h1><div>${hebDate(days[0],false)} – ${hebDate(days[6])}</div></div><div>טובי והחברים · עיצוב ${sk.n}</div></div>
   <table><thead><tr><th>יום</th>${SLOTS.map(s=>`<th>${s.n}</th>`).join('')}<th>בגד תחתון נקי</th><th>משימה יומית</th><th>כוכבים</th></tr></thead><tbody>${rows}</tbody></table>
   <div class="sum">סיכום השבוע: ${sat} ישיבות · ${ok} הצלחות · ${clean} ימים נקיים · ${mis} ימים עם משימה מלאה</div>
   <div class="lg"><b>מילון המרקמים:</b>${[1,2,3,4,5,6,7].map(n=>`<span>${texIcon(n)} ${n}. ${TEX[n].n}</span>`).join('')}</div>
   <div class="notes">הערות להורה / לרופא:</div></div>`;
  let framed=false;try{framed=window.self!==window.top;}catch(e){framed=true;}
  $('printNote').hidden=!framed;
  setTimeout(()=>{try{window.print();}catch(e){}},80);}
$('printBtn').onclick=printWeek;

/* backup & restore */
function filled(d){if(!d)return 0;return (d.ex||[]).length+(d.log||[]).filter(Boolean).length+(d.clean===null||d.clean===undefined?0:1)+(d.sits||0);}
function backupData(){return JSON.stringify({app:'toby-friends',v:1,saved:new Date().toISOString(),data:Object.assign({},S,{lastBackup:dkey(new Date())})});}
function bkMsg(t,err){const m=$('bkMsg');m.textContent=t;m.classList.toggle('err',!!err);}
function markBackup(){S.lastBackup=dkey(new Date());save();bkInfo();}
function bkInfo(){const n=Object.values(S.days).filter(d=>filled(d)).length;
  $('bkLast').textContent=`יש כרגע ${n} ימים עם סימונים.`+(S.lastBackup?` גיבוי אחרון: ${hebDate(parseKey(S.lastBackup))}.`:' עוד לא נשמר גיבוי.');
  const old=!S.lastBackup||(Date.now()-parseKey(S.lastBackup))/864e5>=7;$('bkRemind').hidden=!(n>=3&&old);}
function restore(txt){let o;try{o=JSON.parse(txt.trim());}catch(e){bkMsg('הקוד לא נקרא. בודקים שהועתק במלואו ומנסים שוב.',true);return;}
  const src=o&&o.app==='toby-friends'&&o.data&&o.data.days?o.data:null;
  if(!src){bkMsg('זה לא נראה כמו גיבוי של התוכנה הזו.',true);return;}
  let add=0;for(const[k,d]of Object.entries(src.days)){if(filled(d)>filled(S.days[k])){S.days[k]=d;add++;}}
  ['goal','name','skin','color'].forEach(f=>{if(!S[f]&&src[f])S[f]=src[f];});
  if(src.lastBackup&&(!S.lastBackup||src.lastBackup>S.lastBackup))S.lastBackup=src.lastBackup;
  save();if(SKINS[S.skin])curSkin=S.skin;renderMission();renderStars();renderLog();bkInfo();
  bkMsg(add?(add===1?'השחזור הצליח: עודכן יום אחד.':`השחזור הצליח: עודכנו ${add} ימים.`):'השחזור הסתיים. כל הימים שבגיבוי כבר היו כאן.');confetti();}
$('bkSave').onclick=()=>{let framed=false;try{framed=window.self!==window.top;}catch(e){framed=true;}
  try{const blob=new Blob([backupData()],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='toby-backup-'+dkey(new Date())+'.json';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),4000);}catch(e){framed=true;}
  if(framed){$('bkText').value=backupData();$('bkText').closest('details').open=true;bkMsg('כאן בתוך הקישור אי אפשר לשמור קובץ. העתיקו את קוד הגיבוי שמופיע למטה.',true);}
  else{markBackup();bkMsg('הגיבוי נשמר לתיקיית ההורדות.');}};
$('bkFile').onchange=e=>{const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>restore(String(r.result));r.readAsText(f);e.target.value='';};
$('bkCopy').onclick=()=>{const t=$('bkText');t.value=backupData();
  navigator.clipboard.writeText(t.value).then(()=>{markBackup();bkMsg('קוד הגיבוי הועתק. שמרו אותו במקום בטוח.');},()=>{t.select();bkMsg('סמנו את הקוד והעתיקו אותו ידנית.');});};
$('bkLoad').onclick=()=>{const t=$('bkText').value;if(!t.trim()){bkMsg('קודם מדביקים את קוד הגיבוי בתיבה.',true);return;}restore(t);};
$('bkGo').onclick=()=>{showTab('parent');setTimeout(()=>$('backupH').scrollIntoView({behavior:'smooth'}),50);};
try{navigator.storage&&navigator.storage.persist&&navigator.storage.persist();}catch(e){}
bkInfo();

/* parent legend */
$('texLegend').innerHTML=[1,2,3,4,5,6,7].map(n=>`<span>${texIcon(n)}${n}. ${TEX[n].n}</span>`).join('');


renderMission();renderPosture();renderStars();renderLog();bkInfo();
</script>
