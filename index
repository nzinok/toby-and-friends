function confetti(){
  if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;
  cv.width=innerWidth;cv.height=innerHeight;const cs=getComputedStyle(document.documentElement);
  const cols=['--sun','--rose','--sky','--grape','--leaf'].map(v=>cs.getPropertyValue(v).trim());
  for(let i=0;i<150;i++)parts.push({x:cv.width/2,y:cv.height*.45,vx:(Math.random()-.5)*17,vy:-Math.random()*16-4,r:Math.random()*Math.PI,vr:(Math.random()-.5)*.4,w:6+Math.random()*8,c:cols[i%5],life:1});
  if(!cRun){cRun=true;requestAnimationFrame(cStep);}
}
function cStep(){cx.clearRect(0,0,cv.width,cv.height);parts.forEach(p=>{p.vy+=.45;p.x+=p.vx;p.y+=p.vy;p.vx*=.99;p.r+=p.vr;p.life-=.008;cx.save();cx.globalAlpha=Math.max(0,p.life);cx.translate(p.x,p.y);cx.rotate(p.r);cx.fillStyle=p.c;cx.fillRect(-p.w/2,-p.w/4,p.w,p.w/2);cx.restore();});
  parts=parts.filter(p=>p.life>0&&p.y<cv.height+40);if(parts.length)requestAnimationFrame(cStep);else{cRun=false;cx.clearRect(0,0,cv.width,cv.height);}}

